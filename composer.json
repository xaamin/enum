{
    "name": "xaamin/enum",
    "description": "PHP Enum implementation",
    "keywords": ["enum", "php", "php-enum"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Benjamín Martínez Mateos",
            "email": "xaamin@outlook.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Xaamin\\Enum\\": "src/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.8",
        "pestphp/pest": "^5.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xaamin\\Enum\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    }
}
